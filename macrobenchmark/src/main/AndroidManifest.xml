<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Android 13+ no longer grants legacy external storage permissions to modern
        target SDKs. AndroidX Benchmark still contributes these permissions via its
        library manifest, and the test runner can fail before benchmarks start while
        trying to grant them. Reports and traces are still pulled through the
        benchmark/test infrastructure.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
</manifest>
